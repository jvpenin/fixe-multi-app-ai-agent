# Copy to .env and fill in. Never commit real values.

# --- Demo / fallback ---
# When true, the orchestrator uses src/fixtures instead of calling live APIs.
# Useful before credentials exist, and as a documented demo fallback (never
# presented to the user as a real live response).
DEMO_MODE=true

# --- Google Maps Platform (Places API New) ---
# https://console.cloud.google.com/apis/credentials — restrict this key to
# Places API (New), Maps JavaScript API, and Routes API (the last one powers
# fetchNearbyEssentials()'s public-transit travel time via computeRouteMatrix).
GOOGLE_MAPS_API_KEY=

# --- Google Calendar (OAuth 2.0) ---
# https://console.cloud.google.com/apis/credentials — OAuth client of type
# "Desktop app" (not "Web app"): that grants the loopback redirect exception
# `npm run oauth:google` relies on to catch the auth code automatically on
# whatever free local port it picks, with no redirect URI to pre-register.
# Scope needed: https://www.googleapis.com/auth/calendar.events
# (read + write events; do not request broader Calendar scopes).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Only used by the runtime integration's OAuth2 client constructor; Google
# does not validate it on refresh_token exchanges, so this placeholder is
# fine even though `npm run oauth:google` gets the token via a different
# (loopback) redirect URI.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Obtained once by running `npm run oauth:google`, then reused for the demo account.
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Zinc API (v2, sandbox) ---
# https://app.zinc.com — use a key with the `zn_test_` prefix for sandbox.
# Sandbox test product URLs (see src/integrations/zinc.ts):
#   success        -> https://zinc.com/shop/products/test-success
#   out of stock   -> https://zinc.com/shop/products/test-out-of-stock
#   price exceeded -> https://zinc.com/shop/products/test-price-exceeded
ZINC_API_KEY=
ZINC_API_BASE_URL=https://api.zinc.com
